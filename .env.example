# ── Application ───────────────────────────────────────────────────────────────
# Environment: development | staging | production
ENVIRONMENT=development

# Enable verbose debug logging and Streamlit debug mode
DEBUG=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Format: text (human-readable) | json (for log aggregators)
LOG_FORMAT=text

# Optional path to a rotating log file (leave blank to log to stdout only)
# LOG_FILE=logs/app.log

# Rotating file handler limits
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── File Processing ───────────────────────────────────────────────────────────
# Maximum permitted upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Temporary directory used during file processing
TEMP_DIR=/tmp/resume_parser

# ── Embedding Model ───────────────────────────────────────────────────────────
# Sentence-transformer model name (must be compatible with sentence-transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# In-process LRU cache capacity for computed embeddings
EMBEDDING_CACHE_SIZE=1024

# Batch size for encoding multiple texts in one forward pass
EMBEDDING_BATCH_SIZE=32

# ── Streamlit Server ──────────────────────────────────────────────────────────
SERVER_PORT=8501
SERVER_HEADLESS=true
SERVER_ENABLE_XSRF=true
SERVER_MAX_UPLOAD_MB=10
